CERTIFICATE_EMAIL=
WEB_DOMAINS=

# Cloudflare API token used by Caddy for the DNS-01 ACME challenge
CLOUDFLARE_API_TOKEN=

HTTPS_PROXY_USER=
HTTPS_PROXY_PASSWORD=
HTTPS_PROXY_REJECT_IPS=
HTTPS_PROXY_REJECT_DOMAINS=

# Xray (VLESS)
XRAY_UUID=
XRAY_PATH=/your-secret-path

# Cloudflare WARP egress for naive/xray (load-balanced kernel WireGuard).
WARP_EGRESS=true
# Number of WARP tunnels to register and round-robin across. Each free tunnel
# caps a single flow at ~450 Mbps; N tunnels aggregate that across parallel
# connections (a single stream still ~450).
WARP_ACCOUNTS=4
# WARP edge endpoints, cycled across the N tunnels. Comma- or space-separated.
# Blank falls back to the default Cloudflare WARP endpoint domain.
WARP_ENDPOINTS=
# Optional WARP+ license key (blank = free tier).
WARP_LICENSE_KEY=
