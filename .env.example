CERTIFICATE_EMAIL=
BASE_DOMAIN=

# Cloudflare API token used by Caddy for the DNS-01 ACME challenge
CLOUDFLARE_API_TOKEN=

HTTPS_PROXY_USER=
HTTPS_PROXY_PASSWORD=

# Xray (VLESS)
XRAY_UUID=
XRAY_PATH=/your-secret-path
# A different subdomain of BASE_DOMAIN for each.
VISION_SNI=
XHTTP_SNI=
WS_SNI=
NAIVE_SNI=

# Host ports that publish the xray inbounds DIRECTLY
XRAY_VISION_HOST_PORT=8443
# These ports are deliberately NOT ones Cloudflare auto-forwards,
# so the client always connects to Cloudflare on :443 and a per-SNI 
# Cloudflare Origin Rule rewrites the origin port to these.
XRAY_XHTTP_HOST_PORT=8444
XRAY_WS_HOST_PORT=8445

# Create the DNS records above in Cloudflare automatically (uses the token above).
# Existing records are left alone; set CF_DNS_FORCE=true to update one.
CF_DNS_MANAGE=false
CF_DNS_FORCE=false

# Cloudflare WARP egress for naive/xray (load-balanced kernel WireGuard).
WARP_EGRESS=true
# Number of WARP tunnels to register and round-robin across. Each free tunnel
# caps a single flow at ~450 Mbps; N tunnels aggregate that across parallel
# connections (a single stream still ~450).
WARP_ACCOUNTS=4
# WARP edge endpoints, cycled across the N tunnels. Comma- or space-separated.
# Blank falls back to the default Cloudflare WARP endpoint domain.
WARP_ENDPOINTS=
# Optional WARP+ license key (blank = free tier).
WARP_LICENSE_KEY=
